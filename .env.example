DOCKER_REGISTRY=docker.m.daocloud.io/library/

# Use :80 for plain HTTP by IP. Use your domain name for automatic HTTPS, for example:
# CADDY_SITE_ADDRESS=unipo.example.com
CADDY_SITE_ADDRESS=:80

# Used by deploy-ip.sh. Keep 80 for http://SERVER_IP/.
IP_HTTP_PORT=80

# Server A runs only MySQL with ./deploy-mysql.sh.
MYSQL_PUBLIC_BIND=0.0.0.0
MYSQL_PUBLIC_PORT=12306
MYSQL_DATABASE=biecuoguo
MYSQL_USER=biecuoguo
MYSQL_PASSWORD=change_me_mysql_password
MYSQL_ROOT_PASSWORD=change_me_root_password

# Server B runs backend/frontend/Caddy with ./deploy-app.sh or ./deploy.sh.
# It connects to server A MySQL by default.
# 后端跑在宿主机、MySQL 由 docker compose --profile local-db 提供（宿主机 12306）时用这一条。
# 如果后端也跑在容器里（整栈 docker compose up），改成 jdbc:mysql://mysql:3306/biecuoguo?...
SPRING_DATASOURCE_URL=jdbc:mysql://127.0.0.1:12306/biecuoguo?useUnicode=true&characterEncoding=utf8&serverTimezone=Asia/Shanghai&allowPublicKeyRetrieval=true&useSSL=false
# 没有「所属学校」时的默认学校（未登录访客看 feed、新注册用户还没选学校）。
# 必须指向 schools 表里真实存在的行，否则建号会撞外键。
APP_DEFAULT_SCHOOL_ID=1

SPRING_DATASOURCE_USERNAME=biecuoguo
SPRING_DATASOURCE_PASSWORD=change_me_mysql_password
# 必填，且必须是随机的：JWT 签名密钥，公开等于任何人都能伪造 ADMIN token。
# 生成方式：openssl rand -base64 48（或任意 32 字节以上的随机串）
JWT_SECRET=

# 限流：默认开启。整栈部署（带 Caddy）时保持 true——否则所有人共用一个桶。
# 本地直连后端（npm run dev 代理到 localhost:8080）时不用设，默认就是 false。
RATE_LIMIT_ENABLED=true
RATE_LIMIT_TRUST_FORWARDED_FOR=true
# access token 有效期（分钟）。过期后用 refresh token 换新的，不要改回 7 天。
JWT_EXPIRATION_MINUTES=120
# refresh token 有效期（分钟），默认 14 天。
JWT_REFRESH_EXPIRATION_MINUTES=20160
# 只用于「第一次启动、管理员账号还不存在」时创建该账号；已存在则不会再读，不会覆盖密码。
BOOTSTRAP_ADMIN_EMAIL=admin@biecuoguo.local
BOOTSTRAP_ADMIN_PASSWORD=change_me_admin_password

# ---- 危险开关，默认全关，生产环境不要打开 ----
# 打开后启动时写入 good / xiaoba / yuanhua 三个弱口令演示账号。本地 profile 已默认打开。
BOOTSTRAP_SEED_DEMO_DATA=false
# 打开后任意 4 位数字都能通过验证码校验（等于任何人可注册任意邮箱）。
# 非 local/dev/test profile 下打开会直接拒绝启动，见 config/StartupSafetyGuard.java。
VERIFICATION_MOCK_ACCEPT_ANY_CODE=false

# ---- SMTP：验证码「真实模式」必填 ----
# VERIFICATION_MOCK_ACCEPT_ANY_CODE=false 时，注册和找回密码都要真的把验证码发出去。
# 没有配置 SMTP_HOST 的话后端会直接拒绝启动（StartupSafetyGuard），因为那样新用户永远注册不了。
# 465 端口用 ssl（默认）；587 端口请把 SMTP_SSL_ENABLE 设 false、SMTP_STARTTLS_ENABLE 设 true。
SMTP_HOST=
SMTP_PORT=465
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_SSL_ENABLE=true
SMTP_STARTTLS_ENABLE=false
APP_CORS_ALLOWED_ORIGINS=http://localhost,http://your-server-ip-or-domain

# 数据库 DATETIME 按此时区解释，接口出参统一转成带偏移的 OffsetDateTime。
# 有安全默认值 Asia/Shanghai，不填也行；只在服务器时区不是东八区时才需要改。
APP_TIME_ZONE=Asia/Shanghai

# MinIO is stable and managed outside these scripts. Point these values at the existing MinIO service.
# 本地开发用 docker compose 起 MinIO 时，官方 minio/minio 镜像在国内网络常拉不动，
# compose 默认改用 bitnamilegacy/minio:latest（同一个 MinIO 服务端），可用 MINIO_IMAGE 覆盖。
# MINIO_IMAGE=bitnamilegacy/minio:latest
MINIO_ENDPOINT=http://your-minio-host:9000
MINIO_PUBLIC_ENDPOINT=http://your-minio-public-host:9000
MINIO_ACCESS_KEY=change_me_minio_access_key
MINIO_SECRET_KEY=change_me_minio_secret_key
MINIO_BUCKET=campuspo
MINIO_PUBLIC_READ=false
