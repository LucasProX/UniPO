# Only for docker-compose.test.yml; keep real .env.test private.
# Provision the separate database/user before starting. Never reuse production JWT or database credentials.
SPRING_DATASOURCE_URL=jdbc:mysql://mysql:3306/unipo_test?useUnicode=true&characterEncoding=utf8&serverTimezone=Asia/Shanghai&allowPublicKeyRetrieval=true&useSSL=false
SPRING_DATASOURCE_USERNAME=unipo_test
SPRING_DATASOURCE_PASSWORD=
JWT_SECRET=
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_EMAIL=test-admin@unipo.invalid
MINIO_ENDPOINT=http://minio:9000
MINIO_PUBLIC_ENDPOINT=http://minio:9000
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET=unipo-test-media
MINIO_PUBLIC_READ=false
AUTH_COOKIE_SECURE=false
APP_DEFAULT_SCHOOL_ID=1
APP_TIME_ZONE=Asia/Shanghai
RATE_LIMIT_ENABLED=false
RATE_LIMIT_TRUST_FORWARDED_FOR=false
